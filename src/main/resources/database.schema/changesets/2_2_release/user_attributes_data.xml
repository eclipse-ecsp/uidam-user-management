<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="adding-attribute-label-column-to-user-attributes" author="System">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="user_attributes" columnName="attribute_label" schemaName="${schema}"/>
            </not>
        </preConditions>
        <addColumn tableName="user_attributes" schemaName="${schema}">
            <column name="attribute_label" type="${STRING_SMALL}">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
